SECRET_KEY=troque-esta-chave-por-uma-chave-aleatoria-e-secreta
# Caminho relativo à pasta instance/ (o Flask já resolve a partir dali —
# não prefixe com "instance/" aqui, senão o caminho fica duplicado).
DATABASE_URL=sqlite:///avie.db

# AVIE_ENV=production        # descomente ao rodar em produção (exige SECRET_KEY)

# Usado só por "flask seed-admin" (produção — ver seção "Deploy" no
# README): cria o usuário de acesso sozinho a cada boot, sem prompt
# interativo. Sem efeito localmente a menos que você rode esse comando.
# ADMIN_NAME=Fabiana Montemor
# ADMIN_EMAIL=fabiana@example.com
# ADMIN_PASSWORD=troque-esta-senha-tambem
# ADMIN_ROLE=owner           # owner | marketing

# E-mail de confirmação do diagnóstico (opcional). Sem essas variáveis, o
# sistema apenas registra a mensagem no log em vez de enviar.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-app
# MAIL_DEFAULT_SENDER=contato@fabianamontemor.com.br

# URL pública do site (sem barra no final), usada nos links de compartilhamento
# (og:url, og:image) mostrados quando o link é colado no Instagram, LinkedIn,
# WhatsApp etc. Configure assim que o site tiver um domínio.
# SITE_URL=https://www.fabianamontemor.com.br

# Tags de mensuração (opcional) — cada uma só é inserida no site se a
# variável correspondente estiver definida. Ao ativar, atualize a Política
# de Privacidade para mencionar cookies de conversão/retargeting.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# META_PIXEL_ID=00000000000000000
# LINKEDIN_PARTNER_ID=0000000
